# Sign-in: Privy (Google login, plus a wallet created for each merchant)
#
# Create an app at https://dashboard.privy.io, then:
#   - Login methods: Google ONLY (every merchant needs an email).
#   - Embedded wallets: enable Ethereum/EVM.
#   - User management → Authentication → Advanced: switch on
#     "Return user data in an identity token". Sign-in fails without it,
#     because that token is how our server learns the verified wallet address.
#   - Allowed origins: http://localhost:3000 (add your production URL when you deploy).
#
# Sign-in stays disabled, with a visible message, until BOTH values are set.
#
# The app id is public (it is in the browser). The secret is SERVER ONLY: never
# NEXT_PUBLIC_, never committed, never pasted into chat.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Must match the origin the app is served from.
APP_URL=http://localhost:3000

# Signs the session cookie. Generate with:  openssl rand -base64 32
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Tender API (the backend half — see BACKEND.md)
#
# Every one of these is optional today. While they are unset the API client
# returns a "not_configured" result and every screen renders its empty state,
# which is the intended state until the backend is deployed.
# ---------------------------------------------------------------------------

# Public base URL. Safe in the browser: /public/* routes carry no auth.
# This is what the buyer checkout page calls.
NEXT_PUBLIC_API_URL=

# Server-side base URL. Defaults to NEXT_PUBLIC_API_URL when unset. Set it
# separately only if the server reaches the API on a different host.
TENDER_API_URL=

# ⚠️ The platform key. SERVER ONLY — deliberately not NEXT_PUBLIC_ prefixed, so
# Next never inlines it into the browser bundle. It lets this app act for ANY
# merchant (each call names the signed-in one in X-Tender-Merchant), so anything
# that reads it must run on the server. Use the SAME value as the backend's
# TENDER_PLATFORM_KEY. Generate one with:
#   node -e "console.log('tp_'+require('crypto').randomBytes(32).toString('base64url'))"
# Replaces TENDER_API_KEY, the single fixed merchant key used before sign-ins
# were linked to merchants.
TENDER_PLATFORM_KEY=
