# ---------------------------------------------------------------------------
# Tender API — copy to .env and fill in. The server refuses to start if a
# required value is missing or malformed (see src/config.ts).
#
# Only AURORA_API_KEY is required for local development. Everything else
# defaults to the values below, which match docker-compose.yml.
# ---------------------------------------------------------------------------

# Aurora Intents — create a key at https://studio.aurora.dev
AURORA_API_KEY=
# AURORA_API_URL=https://intents-api.aurora.dev

# NODE_ENV=development
# PORT=4000
# LOG_LEVEL=info

# Postgres on 5434 so it never collides with a host install on 5432.
# DATABASE_URL=postgresql://tender:tender@localhost:5434/tender
# REDIS_URL=redis://localhost:6379

# Origins allowed to call /public/* from a browser (the checkout page).
# CORS_ORIGINS=http://localhost:3000

# How often the poller asks Aurora for deposits, in milliseconds.
# POLL_INTERVAL_MS=5000

# How long a new invoice stays payable, in minutes.
# INVOICE_TTL_MINUTES=30

# A payment within this many basis points of the amount counts as exact.
# PAYMENT_TOLERANCE_BPS=100
# After the deadline, how long a deposit already in flight still counts.
# EXPIRY_GRACE_MINUTES=15
# How long a closed invoice is still watched for late or extra money.
# LATE_WINDOW_HOURS=24
# POLL_CONCURRENCY=4
# POLL_BATCH_SIZE=200

# How often the worker re-measures per-chain minimums, and the safety margin added.
# MINIMUMS_REFRESH_MINUTES=30
# MINIMUM_MARGIN_BPS=2000

# Metrics. If METRICS_TOKEN is set, GET /metrics needs `Authorization: Bearer <token>`.
# METRICS_TOKEN=
# WORKER_METRICS_PORT=9464
