// Tender data model. See BACKEND.md §4.
//
// Three constraints here are load-bearing. Do not relax them:
//   Payment.auroraTxHash @unique        — the poller is at-least-once; this makes a
//                                         double run produce one row, not two.
//   Invoice @@unique([merchantId, reference]) — a merchant retrying a create gets
//                                         the same invoice, not a second charge.
//   InvoiceAddress @@unique([invoiceId, family]) — one address per chain family
//                                         (all EVM chains share one; verified live).
//
// Money is Decimal(36,18). Never Float.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Pinned: Prisma otherwise infers this from tsconfig.json, and `prisma generate`
  // runs in `postinstall` before a Docker build has copied it, which emitted
  // `./internal/class.ts` imports that do not exist in dist.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Merchant {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  /// Google account id (`sub`), permanent. Null for merchants made with the operator CLI.
  googleSub          String?  @unique
  /// Monad (chain 143). Unusable for settlement until settlementVerified is true.
  settlementAddress  String?
  /// Aurora asset id or symbol on Monad, e.g. "USDC".
  settlementAsset    String?
  settlementVerified Boolean  @default(false)
  feeBps             Int      @default(0)
  webhookUrl         String?
  webhookSecret      String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  invoices  Invoice[]
  links     PaymentLink[]
  apiKeys   ApiKey[]
  emails    EmailDelivery[]
  transfers Transfer[]
}

/// A merchant API key. The key itself is shown once and never stored: only its
/// argon2id hash. A merchant can hold several at once, so rotating is: create
/// the new key, deploy it, revoke the old one, with no downtime in between.
model ApiKey {
  id         String    @id
  merchantId String
  merchant   Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  /// First characters of the key, for lookup and for display ("tk_live_ab12…").
  prefix     String    @unique
  hash       String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([merchantId])
}

model Invoice {
  /// "inv_" + base62. Merchant-facing; never in a buyer URL.
  id             String        @id
  /// "chk_" + base62, 160 bits. The only identifier a buyer ever sees.
  token          String        @unique
  merchantId     String
  /// The merchant's own order id.
  reference      String
  amountExpected Decimal       @db.Decimal(36, 18)
  currency       String
  /// Tender chain ids the buyer may pay on, e.g. ["solana", "base"]. Each maps
  /// to one InvoiceAddress by family; EVM chains share the evm address.
  chains         String[]
  status         InvoiceStatus @default(PENDING)
  /// STANDING is a merchant's permanent deposit address, not a bill: it never
  /// expires, is never judged against an amount, and each deposit to it becomes
  /// its own Payment. See services/standing.service.ts.
  kind           InvoiceKind   @default(STANDARD)
  expiresAt      DateTime
  redirectUrl    String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  merchant  Merchant         @relation(fields: [merchantId], references: [id])
  addresses InvoiceAddress[]
  payments  Payment[]
  events    InvoiceEvent[]

  @@unique([merchantId, reference])
  @@index([status, expiresAt])
}

/// A reusable payment link: one URL, many buyers. Each buyer who opens it gets
/// their own invoice (and so their own deposit addresses).
model PaymentLink {
  /// "lnk_" + base62. Merchant-facing.
  id         String   @id
  /// "pl_" + base62, 160 bits. The only identifier in the public URL.
  token      String   @unique
  merchantId String
  label      String
  /// Null: the buyer chooses the amount.
  amount     Decimal? @db.Decimal(36, 18)
  currency   String
  active     Boolean  @default(true)
  uses       Int      @default(0)
  createdAt  DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId, createdAt])
}

model InvoiceAddress {
  id           String   @id @default(cuid())
  invoiceId    String
  /// Aurora deposit family: "evm" | "sol" | "btc" | "tron" | … (constraint #2).
  family       String
  address      String
  /// What we passed to Aurora as `sender` — the invoice id (constraint #6).
  auroraSender String
  /// Per-address poll backoff: one failing address must never stall the loop.
  pollFailures Int      @default(0)
  nextPollAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  invoice  Invoice   @relation(fields: [invoiceId], references: [id])
  payments Payment[]

  @@unique([invoiceId, family])
  @@index([address])
  @@index([nextPollAt])
}

model Payment {
  id               String        @id @default(cuid())
  invoiceId        String
  invoiceAddressId String
  /// Dedupe key. ⚠️ Whether Aurora's `received` and `success` entries share this
  /// hash is not yet verified live — see BACKEND.md §1.
  auroraTxHash     String        @unique
  fromChain        String
  /// Aurora asset id of what the buyer sent, e.g. "nep141:sol.omft.near".
  assetIn          String?
  amountIn         Decimal       @db.Decimal(36, 18)
  /// USD value of amountIn at detection, from Aurora's price feed. What
  /// coverage is judged on: fees are the merchant's cost, as with a card.
  amountInUsd      Decimal?      @db.Decimal(36, 18)
  amountSettled    Decimal?      @db.Decimal(36, 18)
  /// The payout (success/failed list) entry this payment was matched to.
  outcomeTxHash    String?       @unique
  status           PaymentStatus
  firstSeenAt      DateTime      @default(now())
  settledAt        DateTime?
  /// The untouched Aurora payload(s), for audit.
  raw              Json

  invoice  Invoice        @relation(fields: [invoiceId], references: [id])
  address  InvoiceAddress @relation(fields: [invoiceAddressId], references: [id])
  recovery RecoveryTask?
  refunds  Transfer[]
}

/// Every status change an invoice goes through. Backs the dashboard's history
/// view and replays to an SSE client that connects late.
model InvoiceEvent {
  id        String        @id
  invoiceId String
  status    InvoiceStatus
  paymentId String?
  note      String?
  at        DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId, at])
}

model WebhookDelivery {
  id          String    @id @default(cuid())
  merchantId  String
  invoiceId   String
  event       String
  payload     Json
  attempts    Int       @default(0)
  nextRetryAt DateTime?
  deliveredAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([deliveredAt, nextRetryAt])
}

/// Outbox for transactional email (the welcome message). Written in the same
/// transaction as the thing that triggers it, so a merchant exists if and only
/// if its welcome is queued. The unique pair is what makes it once-only.
model EmailDelivery {
  id          String    @id @default(cuid())
  merchantId  String
  merchant    Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  kind        String
  toEmail     String
  attempts    Int       @default(0)
  nextRetryAt DateTime?
  sentAt      DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())

  @@unique([merchantId, kind])
  @@index([sentAt, nextRetryAt])
}

model RecoveryTask {
  id        String        @id @default(cuid())
  paymentId String        @unique
  reason    String
  state     RecoveryState @default(OPEN)
  attempts  Int           @default(0)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])
}

enum InvoiceKind {
  STANDARD
  STANDING
}

enum InvoiceStatus {
  PENDING
  DETECTED
  SETTLED
  OVERPAID
  UNDERPAID
  EXPIRED
  CANCELLED
  NEEDS_RECOVERY
}

enum PaymentStatus {
  DETECTED
  SETTLED
  FAILED
  REFUNDED
}

enum RecoveryState {
  OPEN
  RETRYING
  WITHDRAWN
  RESOLVED
  FAILED
}

/// Money the merchant sent OUT of their own wallet: a payout, a refund or a split.
///
/// Tender never holds or moves these funds. The merchant's wallet signs one
/// EIP-3009 authorization per line ("send exactly this much to that address,
/// until this time"); Tender's relayer submits them on-chain and pays the gas.
/// This row is the record of that: what was asked, what was signed, and what
/// the chain says happened. It never claims money moved until a receipt says so.
model Transfer {
  id            String         @id @default(cuid())
  merchantId    String
  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  kind          TransferKind
  status        TransferStatus @default(AWAITING_SIGNATURE)
  /// "USDC" or "USDT0": the token these lines are denominated in.
  asset         String
  /// The merchant's settlement address when this was prepared: the only address that may sign.
  fromAddress   String
  /// Sum of the lines.
  totalAmount   Decimal        @db.Decimal(36, 18)
  /// A refund points at the payment it returns money for.
  paymentId     String?
  payment       Payment?       @relation(fields: [paymentId], references: [id])
  note          String?
  /// Every authorization is valid until here; unsubmitted past this, nothing can ever move.
  expiresAt     DateTime
  txHash        String?        @unique
  failureReason String?
  createdAt     DateTime       @default(now())
  submittedAt   DateTime?
  confirmedAt   DateTime?
  lines         TransferLine[]

  @@index([merchantId, createdAt])
  @@index([status, expiresAt])
  @@index([paymentId])
}

model TransferLine {
  id         String   @id @default(cuid())
  transferId String
  transfer   Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  index      Int
  toAddress  String
  amount     Decimal  @db.Decimal(36, 18)
  /// The EIP-3009 nonce (bytes32, random). Used on-chain exactly once.
  nonce      String
  /// The merchant wallet's signature over this line, once given.
  signature  String?

  @@unique([transferId, index])
}

enum TransferKind {
  PAYOUT
  REFUND
  SPLIT
}

enum TransferStatus {
  AWAITING_SIGNATURE
  SUBMITTED
  CONFIRMED
  FAILED
  EXPIRED
}
