# Google OAuth — create these at https://console.cloud.google.com/apis/credentials
#
#   1. Create project → APIs & Services → Credentials
#   2. Create OAuth client ID → Web application
#   3. Authorised redirect URI: http://localhost:3000/app/callback
#      (add your production URL there too when you deploy)
#
# Copy this file to .env.local and fill both values in. Sign-in stays disabled,
# with a visible message, until they are present.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match the origin the app is served from — it builds the redirect URI.
APP_URL=http://localhost:3000

# Signs the session cookie. Generate with:  openssl rand -base64 32
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Tender API (the backend half — see BACKEND.md)
#
# Every one of these is optional today. While they are unset the API client
# returns a "not_configured" result and every screen renders its empty state,
# which is the intended state until the backend is deployed.
# ---------------------------------------------------------------------------

# Public base URL. Safe in the browser: /public/* routes carry no auth.
# This is what the buyer checkout page calls.
NEXT_PUBLIC_API_URL=

# Server-side base URL. Defaults to NEXT_PUBLIC_API_URL when unset. Set it
# separately only if the server reaches the API on a different host.
TENDER_API_URL=

# ⚠️ The merchant API key. SERVER ONLY — deliberately not NEXT_PUBLIC_ prefixed,
# so Next never inlines it into the browser bundle. It can create invoices and
# move settlement, so anything that reads it must run on the server.
TENDER_API_KEY=
